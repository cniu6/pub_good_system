# ===== 应用基础配置 =====
# 应用名称
APP_NAME=fst-platform
# 运行模式：dev = 开发环境 | prod = 生产环境
APP_MODE=dev
# 服务监听端口
PORT=8080

# ===== HTTP 服务超时配置 =====
# 说明：Go 默认 net/http 不限制这些超时，生产环境建议显式配置以防慢连接占满资源
# 请求头读取超时（单位：秒，Slowloris 防护首选）
HTTP_READ_HEADER_TIMEOUT_SECONDS=5
# 整个请求读取超时（单位：秒）
HTTP_READ_TIMEOUT_SECONDS=5
# 响应写入超时（单位：秒）
HTTP_WRITE_TIMEOUT_SECONDS=60
# Keep-Alive 空闲连接超时（单位：秒）
HTTP_IDLE_TIMEOUT_SECONDS=120
# 优雅关闭等待超时（单位：秒）
HTTP_SHUTDOWN_TIMEOUT_SECONDS=10
# 请求头最大字节数（默认 1MB）
HTTP_MAX_HEADER_BYTES=1048576

# ===== 数据库配置 =====
# 数据库驱动类型：mysql | postgres | sqlite
DB_DRIVER=mysql
# 数据库主机地址
DB_HOST=127.0.0.1
# 数据库端口
DB_PORT=3306
# 数据库用户名
DB_USER=root
# 数据库密码
DB_PASSWORD=root
# 数据库名称
DB_NAME=fst_platform

# ===== 极验验证码配置 =====
# 极验行为验证 ID（GeeTest CaptchaID）
GEETEST_ID=
# 极验行为验证密钥（GeeTest Key）
GEETEST_KEY=

# ===== 安全与功能开关 =====
# 运行环境：development | production（也可用 GO_ENV / GIN_MODE）
# 生产务必设为 production，否则部分安全校验会按开发模式放宽
APP_ENV=development
# JWT 签名密钥（env 填入即可；生产仅「空」会拒绝启动，占位/默认值不再 fatal）
# 生产建议换成足够长的随机串，但不再因过短/示例值拦死启动
JWT_SECRET=change_me_to_a_long_random_secret
# 管理端 JWT 密钥（可选；留空则与 JWT_SECRET 相同）
JWT_ADMIN_SECRET=
# 前端管理后台页面入口（隐藏后台用），与 frontend VITE_ADMIN_BASE_PATH 一致
ADMIN_PATH=/system-mgr
# 管理端 REST API 在 /api/v1 下的前缀（默认 /admin），改这里即可全局换 API 路径
# 实际完整路径：/api/v1{ADMIN_API_PATH}，例如 /api/v1/admin
# 前端通过 /api/v1/public/app-config 的 admin_api_path 运行时注入，无需为改此项单独重建前端
# VITE_ADMIN_API_PATH 仅作 app-config 失败时的回退；Swagger doc.json 也会按此项改写路径
# 注意：页面入口（ADMIN_PATH）与 API 前缀（ADMIN_API_PATH）分离，可独立切换
ADMIN_API_PATH=/admin
# 是否启用极验验证码：true = 开启 | false = 关闭
GEETEST_ENABLED=true
# 是否启用 Swagger API 文档：true = 开启 | false = 关闭（生产建议 false）
ENABLE_SWAGGER=true
# 管理端 debug/pprof/强制GC/手动任务/重启 等高危能力：生产永远关闭；非生产默认 true，可设 false 关闭
ENABLE_ADMIN_DEBUG=true

# ===== 邮件服务配置 (SMTP) =====
# SMTP 服务器地址
SMTP_HOST=
# SMTP 服务器端口（465 为 SSL，587 为 STARTTLS）
SMTP_PORT=465
# SMTP 登录用户名
SMTP_USERNAME=
# SMTP 登录密码 / 授权码
SMTP_PASSWORD=
# SSL 加密类型：ssl | tls | none
SMTP_SSL_TYPE=ssl
# 邮件编码格式
SMTP_ENCODING=utf-8
# 系统发件人显示名称
SYSTEM_EMAIL_NAME=FST
# 系统发件人邮箱地址
SYSTEM_EMAIL_ADDRESS=

# ===== 前端显示与跨域配置 =====
# 页面标题，显示在浏览器标签栏
APP_TITLE=FST Platform
# CORS 允许的来源（必填，空配置会拒绝启动）
# 允许 *（任意来源；此时不带 Credentials）
# 支持精确域名与泛域名，多个用英文逗号分隔，例如：
# CORS_ORIGINS=https://www.example.com,https://admin.example.com
# CORS_ORIGINS=*.example.com
# CORS_ORIGINS=https://*.example.com
CORS_ORIGINS=*
# 前端访问地址（如 http://example.com），结尾不要加 /
# 说明：当前项目运行时优先读取 system_settings，以下字段仅在数据库未配置时作为兜底参考
FRONTEND_URL=
# 后端 API 外网地址（如 http://api.example.com），结尾不要加 /
# 说明：当前项目运行时优先读取 system_settings，以下字段仅在数据库未配置时作为兜底参考
BACKEND_API_URL=

# ===== 注册与登录安全策略 =====
# 注册验证码有效期（单位：分钟）
REGISTER_CODE_EXPIRE_MINUTES=15
# 登录最大连续失败次数，超过后将锁定账户
LOGIN_MAX_FAILURE_COUNT=5
# 登录失败锁定时长（单位：分钟）
LOGIN_LOCK_DURATION_MINUTES=10
# JWT Access Token 有效期（单位：秒，7200 = 2小时）
JWT_ACCESS_EXPIRE=7200
# JWT Refresh Token 有效期（单位：秒，604800 = 7天）
JWT_REFRESH_EXPIRE=604800

# ===== 定时任务配置 =====
# 验证码清理任务执行间隔（单位：分钟，默认 10）
CLEANUP_INTERVAL_MINUTES=10

# ===== 短信服务配置 =====
# 说明：当前项目运行时优先读取 system_settings / 管理员后台配置；以下字段仅在数据库未配置时作为兜底参考
# 短信验证码开关
SMS_VERIFY_ENABLED=false
# 服务商: console | aliyun | tencent | custom
SMS_PROVIDER=console
# aliyun: AccessKeyId + AccessKeySecret + SignName + TemplateCode，默认区域 cn-hangzhou
# tencent: SecretId + SecretKey + SmsSdkAppId + 签名内容 + TemplateId，默认区域 ap-guangzhou
# custom: ACCESS_KEY/SECRET_KEY 会分别作为 X-Api-Key / Authorization Bearer 使用
# 阿里云 AccessKeyId / 腾讯云 SecretId / 自定义网关 API Key
SMS_ACCESS_KEY=
# 阿里云 AccessKeySecret / 腾讯云 SecretKey / 自定义网关 API Secret
SMS_SECRET_KEY=
# 短信签名
SMS_SIGN_NAME=
# 模板ID/模板Code
SMS_TEMPLATE_CODE=
# 英文模板ID/模板Code，可选；仅在 lang=en-US 时优先使用，未填写则回退默认模板
SMS_TEMPLATE_CODE_EN=
# 服务区域，例如: cn-hangzhou / ap-guangzhou；留空时走项目内默认值
SMS_REGION=
# 腾讯云专用 SmsSdkAppId
SMS_SDK_APP_ID=
# 自定义 HTTP 网关地址
SMS_ENDPOINT=
# 自定义网关请求体格式: json | form
SMS_BODY_FORMAT=json

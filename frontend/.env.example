# ===== 前端环境变量（与根目录 .env 对齐）=====
# 开发/生产请分别写在 .env.dev / .env.production

# 后端 API 地址（开发代理目标；embedded 打包时生产可留空走同源）
VITE_API_URL=http://localhost:8080

# 是否开启 Vite 开发代理（Y=走 /api 同源代理，N=直连 VITE_API_URL）
VITE_HTTP_PROXY=Y

# 管理后台【前端页面】入口路径（须与根目录 .env 的 ADMIN_PATH 一致）
VITE_ADMIN_BASE_PATH=/system-mgr

# 管理端 REST API 在 /api/v1 下的前缀（须与根目录 .env 的 ADMIN_API_PATH 一致，默认 /admin）
# 完整路径 = /api/v1 + 本项，例如 /api/v1/admin
VITE_ADMIN_API_PATH=/admin

# 站点 base（一般保持 /）
VITE_BASE_URL=/

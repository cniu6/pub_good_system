# ===== 基础配置 =====
# 项目根目录路径，部署在子目录时需修改（如 /sub-path/）
VITE_BASE_URL=/
# 项目名称，用于页面显示和浏览器标签
VITE_APP_NAME=F.st
# 项目标题，显示在浏览器标签栏
VITE_APP_TITLE=F.st - Think Fast,Run F.st

# ===== 路由配置 =====
# 路由模式：web = HTML5 History 模式 | hash = Hash 模式
VITE_ROUTE_MODE=web
# 路由加载模式：static = 静态路由 | dynamic = 动态路由（从后端获取）
VITE_ROUTE_LOAD_MODE=static
# 登录成功后的默认跳转页面路径
VITE_HOME_PATH=/user/dashboard/workbench

# ===== 存储配置 =====
# 本地存储键名前缀，用于区分不同项目的 localStorage 数据
VITE_STORAGE_PREFIX=

# ===== Token 配置 =====
# 是否自动刷新 Token：Y = 启用 | N = 禁用
# 关闭时 access token 到期（默认2小时）后会直接强退登录，需重新登录；开发/长时间挂着后台易频繁 401。
# 开启后会用 refresh token（默认7天）静默换新 access token，不会打断使用。
VITE_AUTO_REFRESH_TOKEN=Y
# Token 过期前提前刷新的时间（单位：秒）
VITE_TOKEN_REFRESH_AHEAD=60

# ===== 后端服务地址 =====
# 后端 API 默认地址（可在 .env.dev 和 .env.production 中分别覆盖，此处填开发环境示例值）
VITE_API_URL=http://localhost:8085

# ===== 管理后台配置 =====
# 管理端自定义路由前缀路径
# 【安全建议】生产环境必须修改为不易猜测的随机路径，如：
# - VITE_ADMIN_BASE_PATH=/x7k9m2p
# - VITE_ADMIN_BASE_PATH=/sys-console-abc123
# 避免使用 /admin、/management、/system-mgr 等常见路径（此处仅作示例，请自行替换）
VITE_ADMIN_BASE_PATH=/system-mgr

# ===== 国际化与协议 =====
# 默认语言：enUS = 英文 | zhCN = 中文（与后端 system_settings.default_lang=zhCN 对齐）
VITE_DEFAULT_LANG=zhCN
# 用户协议/服务条款链接地址
VITE_USER_AGREEMENT_URL=https://example.com/agreement

# ===== 页脚信息 =====
# 页面底部版权声明文字
VITE_COPYRIGHT_INFO=Copyright © 2024 F.st

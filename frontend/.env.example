# ===== 前端环境变量（与根目录 .env 对齐）=====
# 开发/生产请分别写在 .env.dev / .env.production

# 后端 API 地址（开发代理目标；embedded 打包时生产可留空走同源）
VITE_API_URL=http://localhost:8080

# 是否开启 Vite 开发代理（Y=走 /api 同源代理，N=直连 VITE_API_URL）
VITE_HTTP_PROXY=Y

# 是否自动刷新 Token：Y=启用（推荐，到期用 refresh token 静默换新，不打断登录）| N=禁用（到期直接强退）
VITE_AUTO_REFRESH_TOKEN=Y
# Token 过期前提前刷新的时间（单位：秒）
VITE_TOKEN_REFRESH_AHEAD=60

# 管理后台【前端页面】入口路径（须与根目录 .env 的 ADMIN_PATH 一致）
VITE_ADMIN_BASE_PATH=/system-mgr

# 管理端 REST API 前缀（仅作 app-config 加载失败时的回退；正常以后端 ADMIN_API_PATH 注入为准）
# 完整路径 = /api/v1 + 本项，例如 /api/v1/admin
VITE_ADMIN_API_PATH=/admin

# 构建模式：embedded=单二进制同源 API；其它值则生产使用 VITE_API_URL
VITE_BUILD_MODE=embedded

# 站点 base（一般保持 /）
VITE_BASE_URL=/

# 构建模式（可选）：embedded=嵌入后端单二进制，生产 API 走同源
# 一般由打包脚本注入，不必手写
# VITE_BUILD_MODE=embedded

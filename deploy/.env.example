# Docker Compose 示例环境变量（勿提交真实密钥）
# 复制为 deploy/.env 后按需修改，或在根目录维护 .env 再 --env-file 指向它

FST_PORT=8080

# 数据库：默认 MySQL 服务名 mysql；切 Postgres 时改为 postgres 并加 --profile postgres
DB_DRIVER=mysql
# MySQL 变量组
DB_MYSQL_HOST=mysql
DB_MYSQL_PORT=3306
DB_MYSQL_USER=fst
DB_MYSQL_PASSWORD=fst_change_me
DB_MYSQL_NAME=fst_platform

# Postgres 示例（切库时取消注释并把 DB_DRIVER 改为 postgres）：
# DB_POSTGRES_HOST=postgres
# DB_POSTGRES_PORT=5432
# DB_POSTGRES_USER=fst
# DB_POSTGRES_PASSWORD=fst_change_me
# DB_POSTGRES_NAME=fst_platform
# DB_POSTGRES_SSLMODE=disable

MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_PUBLISH_PORT=3306
POSTGRES_PUBLISH_PORT=5432

CORS_ORIGINS=*
JWT_SECRET=change_me_to_a_long_random_secret_for_docker

# ===== 生产环境配置示例（.env.production.example）=====
# 用法：复制为可执行文件同级或仓库根目录的 .env，再按实际环境改值。
# 查找优先级与 .env.example 相同；禁止再写 backend/.env。
# 前端 VITE_* 请写在 frontend/.env.production，不要写进本文件。
#
# 本文件默认值偏向「生产安全」：关掉 Swagger/Debug、禁止 CORS=*、强制 MySQL。
# 带「危险」标注的项若改错，可能直接导致越权、信息泄露或令牌伪造。

# ===== 应用基础配置 =====
APP_NAME=fst-platform
# 【生产】必须为 prod / production / release，否则安全校验会按开发模式放宽
APP_MODE=prod
PORT=8080

# ===== HTTP 服务超时配置 =====
HTTP_READ_HEADER_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=5
HTTP_WRITE_TIMEOUT_SECONDS=60
HTTP_IDLE_TIMEOUT_SECONDS=120
HTTP_SHUTDOWN_TIMEOUT_SECONDS=10
HTTP_MAX_HEADER_BYTES=1048576

# ===== 数据库配置 =====
# 【生产】请用 mysql（或 postgres）；sqlite 无行锁、单写者，不适合生产
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fst_user
# 【危险】请换成强密码，勿提交真实口令到仓库
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=fst_platform
# PostgreSQL 时改端口与 SSL，例如：
# DB_PORT=5432
# DB_SSLMODE=require

# ===== 极验验证码配置 =====
GEETEST_ID=
GEETEST_KEY=

# ===== 安全与功能开关 =====
# 【生产】建议 production；也可与 APP_MODE=prod 二选一/同时设置
APP_ENV=production
# 【危险】JWT 签名密钥：必须换成足够长的随机串（建议 >=32 字符），勿用示例占位值
# 生成示例（PowerShell）：[Convert]::ToBase64String((1..48|%{Get-Random -Max 256}) -as [byte[]])
# 生成示例（openssl）：openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
# 管理端 JWT 密钥（可选；留空则与 JWT_SECRET 相同）。若单独配置，同样必须是强随机串
JWT_ADMIN_SECRET=
# 管理后台页面入口（与 frontend VITE_ADMIN_BASE_PATH 一致），生产建议改成不易猜测的路径
ADMIN_PATH=/system-mgr
ADMIN_API_PATH=/admin
GEETEST_ENABLED=true
# 【危险】生产务必 false：Swagger 会暴露完整 API 与模型细节
ENABLE_SWAGGER=false
# 【危险】生产务必 false：debug/pprof/强制 GC/手动任务/重启 等高危能力
# （即便设为 true，生产模式代码侧也会强制关闭）
ENABLE_ADMIN_DEBUG=false

# ===== 邮件服务配置 (SMTP) =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL_TYPE=ssl
SMTP_ENCODING=utf-8
SMTP_PROXY_ENABLED=false
SMTP_PROXY_TYPE=socks5
SMTP_PROXY_HOST=
SMTP_PROXY_PORT=1080
SMTP_PROXY_USERNAME=
SMTP_PROXY_PASSWORD=
SYSTEM_EMAIL_NAME=FST
SYSTEM_EMAIL_ADDRESS=

# ===== 前端显示与跨域配置 =====
APP_TITLE=FST Platform
# 【危险】切勿使用 *：任意来源可跨域带业务请求；生产必须写具体域名（可多值逗号分隔）
# 正确示例：
# CORS_ORIGINS=https://www.example.com,https://admin.example.com
# 泛域名示例（仍非任意来源）：CORS_ORIGINS=https://*.example.com
CORS_ORIGINS=https://www.example.com
AUTH_CORS_ENABLED=false
AUTH_CORS_ORIGINS=
WS_CORS_ENABLED=false
WS_CORS_ORIGINS=
# 前端 / API 外网地址（结尾不要加 /）；运行时优先读 system_settings，此处作兜底
FRONTEND_URL=https://www.example.com
BACKEND_API_URL=https://api.example.com

# ===== 注册与登录安全策略 =====
REGISTER_CODE_EXPIRE_MINUTES=15
LOGIN_MAX_FAILURE_COUNT=5
LOGIN_LOCK_DURATION_MINUTES=10
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=604800

# ===== 定时任务配置 =====
CLEANUP_INTERVAL_MINUTES=10

# ===== 短信服务配置 =====
# 运行时优先读 system_settings；以下仅作库未配置时的兜底
SMS_VERIFY_ENABLED=false
SMS_PROVIDER=console
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_TEMPLATE_CODE_EN=
SMS_REGION=
SMS_SDK_APP_ID=
# 【危险】custom 通道会向该 URL 发 HTTP；须公网 https，内网/元数据地址会被 SSRF 防护拒绝
SMS_ENDPOINT=
SMS_BODY_FORMAT=json
